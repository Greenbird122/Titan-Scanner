# =============================================================================
# Titan Scanner — Environment Variables
# Copy this file to .env and fill in the values you need.
# Not all variables are required; each section notes when it's needed.
# =============================================================================

# ---------------------------------------------------------------------------
# AI / LLM Integration (optional — enables AI payload mutation & escalation)
# ---------------------------------------------------------------------------

# DeepSeek API (used by PayloadSmith for AI-generated payloads)
DEEPSEEK_API_KEY=
DEEPSEEK_AUTH_TOKEN=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama (local LLM alternative — set host if running remotely)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ---------------------------------------------------------------------------
# Tor / Proxy (optional — enables Tor-routed scanning)
# ---------------------------------------------------------------------------

# SOCKS5 proxy for Tor routing
TOR_SOCKS_PROXY=socks5://127.0.0.1:9050

# Tor control port for circuit management
TOR_CONTROL_PORT=9051

# ---------------------------------------------------------------------------
# Exploit / Consent (required for Track E exploitation phase)
# ---------------------------------------------------------------------------

# Directory to store signed consent files (one per target)
TITAN_CONSENT_DIR=consent

# ---------------------------------------------------------------------------
# Supabase / Firebase (used by deep audit module for BaaS detection)
# Never hardcode real keys here — use env vars at runtime only.
# ---------------------------------------------------------------------------

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Firebase Web API key + project id (read by deep_verify.py / firebase_*.py probes)
# FIREBASE_API_KEY=
# FIREBASE_PROJECT=

# ---------------------------------------------------------------------------
# Local lab (deliberately vulnerable Flask app)
# ---------------------------------------------------------------------------

# Flask secret key for the lab. If unset, a random key is generated per boot.
LOCAL_LAB_SECRET_KEY=

# Bind host/port for `python -m titan lab start` (defaults: 127.0.0.1:5000)
TITAN_LAB_HOST=127.0.0.1
TITAN_LAB_PORT=5000

# Set to 1 to run the lab with Flask debug mode
TITAN_LAB_DEBUG=
